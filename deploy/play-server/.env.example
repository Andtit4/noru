# The website allowed to use the rooms (its exact origin: scheme and host, no trailing slash).
SITE_ORIGIN=https://my-site.netlify.app
# The name the rooms are served at over HTTPS. Without a domain, <ip-with-dashes>.sslip.io points
# to the server's IP and works with Let's Encrypt, e.g. 203-0-113-7.sslip.io.
ROOMS_HOST=203-0-113-7.sslip.io
# The branch or tag of noru to build.
NORU_REF=main
