{
  "name": "noru-bundler",
  "version": "0.3.0",
  "description": "A fast, zero-config bundler for React + TypeScript apps and Next.js App Router apps, written in Rust.",
  "keywords": [
    "bundler",
    "build",
    "react",
    "nextjs",
    "next",
    "tailwindcss",
    "typescript",
    "rust",
    "vite",
    "napi"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Andtit4/noru#readme",
  "bugs": {
    "url": "https://github.com/Andtit4/noru/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andtit4/noru.git",
    "directory": "packages/noru"
  },
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "noru": "bin/noru.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "binding.js",
    "binding.d.ts",
    "preview.js",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "binaryName": "noru",
    "packageName": "@titoandele/noru",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "build:debug": "napi build --platform --js binding.js --dts binding.d.ts",
    "test": "node test/smoke.js",
    "create-npm-dirs": "napi create-npm-dirs",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.12"
  }
}
